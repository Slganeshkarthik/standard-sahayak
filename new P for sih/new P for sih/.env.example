# ═══════════════════════════════════════════════════════════════
# Standards Sahayak — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════

# Google Gemini API Key for Semantic Embeddings and RAG Reasoning
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key — Multilingual Translation, TTS & STT (22 Indian Languages)
# Get a free key at: https://dashboard.sarvam.ai/
# Supports: Hindi, Bengali, Gujarati, Kannada, Malayalam, Marathi, Odia, Punjabi, Tamil, Telugu
# If not set, the system gracefully falls back to the built-in Unicode language detector
SARVAM_API_KEY=your_sarvam_api_key_here



# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
